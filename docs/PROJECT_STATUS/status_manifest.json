  "planned": [
    {
      "id": "P-01",
      "area": "C3",
      "name": "Linux application compatibility runtime",
      "acceptance": "ELF/Linux syscall personality, dynamic loader/library path, capability-mediated host API, real application vertical slice and negative conformance tests."
    },
    {
      "id": "P-02",
      "area": "C3",
      "name": "Windows application compatibility runtime",
      "acceptance": "PE/COFF loader, Win32/NT API surface, library resolution, real application vertical slice and negative conformance tests."
    },
    {
      "id": "P-03",
      "area": "C4",
      "name": "Whole-OS hardware hypervisor",
      "acceptance": "VMX/SVM/EL2, guest memory translation, vCPU/VM-exit lifecycle, virtual devices, IOMMU isolation and guest boot tests."
    },
    {
      "id": "P-04",
      "area": "K",
      "name": "User-mode system service lifecycle",
      "acceptance": "Service Manager, Event Bus, Resource/Power Manager, versioned IPC, backpressure, crash/restart and peer-death tests."
    },
    {
      "id": "P-05",
      "area": "L",
      "name": "Transactional installer, updater and recovery",
      "acceptance": "Atomic update, signed manifests, rollback/anti-rollback, interrupted-update recovery, boot fallback and reproducible update archive."
    },
    {
      "id": "P-06",
      "area": "G",
      "name": "Verified foreign-driver adaptation pipeline",
      "acceptance": "Source provenance and license verification, explicit source adapters, target ABI conversion, sandboxed build/test, signing and rollback. No arbitrary binary-driver rewriting claims."
    },
    {
      "id": "P-07",
      "area": "M/G",
      "name": "Physical hardware qualification",
      "acceptance": "Separate recorded test matrices for representative x86-64 and ARM64 devices, including boot, display/input, storage, network, DMA/IOMMU, power and recovery."
    },
    {
      "id": "P-08",
      "area": "G/M",
      "name": "Additional physical device classes",
      "acceptance": "Wi-Fi, Bluetooth, cameras, sensors and accelerated hardware GPU support with device-specific evidence."
    },
    {
      "id": "P-09",
      "area": "C2",
      "name": "Complete native runtime and dynamic linking",
      "acceptance": "Versioned Native ABI, shared libraries/dynamic linker, relocation validation and cross-ISA conformance."
    },
    {
      "id": "P-10",
      "area": "D/F",
      "name": "Formal Mind authority and model lifecycle",
      "acceptance": "Typed bounded proposals, owner-side policy enforcement, audit/rollback, model versioning/signature and adversarial tests."
    }
  ]
